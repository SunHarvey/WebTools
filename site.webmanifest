{
  "name": "UtilCover Browser Tools",
  "short_name": "UtilCover",
  "description": "Private browser tools that run locally on your device.",
  "start_url": "/tools/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#08111f",
  "theme_color": "#08111f",
  "icons": [
    {
      "src": "/images/icon-192.png",
      "sizes": "192x192",
